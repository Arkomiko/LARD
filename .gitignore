.grunt

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules
jspm_packages

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

static/bundle.js
esdoc
pkg
build
dist

*.env
*.provisionprofile
.turbo
*.pfx

# JetBrains data
.idea

#IA generated files
CLAUDE.md
.claude
task.md

# LARD: собранные продукты. Структура папок в репозитории нужна (её держат
# файлы null-time.txt), а сами сборки весят сотни мегабайт и пересобираются
# командой Build — хранить их незачем.
app_r/**
!app_r/**/
!app_r/**/null-time.txt

# Промежуточное при сборке инструментов: веб-часть, разложенная в оболочку,
# и результат упаковщика.
source_dev/core/tools_shell/renderer/
source_dev/core/tools_shell/out/
