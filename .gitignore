# Личная служебная папка автора (заметки, черновики) — не часть проекта
.claude/

# Зависимости: восстанавливаются командами установки, хранить незачем
node_modules/

# Результаты сборки: .NET кладёт их в bin/ и obj/, веб-интерфейс — в dist/,
# мост (CMake) — в build/. Готовые сборки выкладываются в Releases на GitHub.
bin/
obj/
dist/
build/
out/

# Файлы редакторов кода, у каждого разработчика свои
.vs/
.idea/
*.user
*.suo

# Временные файлы и логи
*.log
*.tmp
logs/
Thumbs.db
desktop.ini
