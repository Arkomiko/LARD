{
  "editor.tabSize": 2,
  "javascript.validate.enable": false,
  "typescript.tsdk": "source_dev/node_modules/typescript/lib",
  "typescript.preferences.importModuleSpecifier": "relative",
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "testing.automaticallyOpenTestResults": "neverOpen",

  // LARD: не искать npm-скрипты по всему дереву. Иначе в списке запуска
  // оказываются скрипты каждого пакета и каждой служебной папки — вплоть до
  // генератора иконок и содержимого собранных продуктов. Нужные команды
  // перечислены задачами в tasks.json.
  "npm.autoDetect": "off",
  "typescript.tsc.autoDetect": "off",

  // Собранное и служебное не показываем ни в поиске, ни в дереве файлов:
  // это сотни мегабайт машинного вывода, который пересобирается командой.
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/dist_renderer": true,
    "**/out": true,
    "**/.turbo": true,
    "app_r/*/Windows_Standalone": true,
    "source_dev/core/tools_shell/renderer": true
  },
  "files.exclude": {
    "**/.turbo": true,
    "source_dev/core/tools_shell/renderer": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/out/**": true,
    "**/app_r/**": true
  }
}
