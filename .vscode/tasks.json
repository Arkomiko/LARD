{
  // Список запуска LARD. Автопоиск npm-скриптов выключен в settings.json,
  // поэтому здесь ровно то, что нужно человеку, и ничего больше.
  //
  // Команды вызываются напрямую (type: process), а не через оболочку: в
  // PowerShell запуск `npm.ps1` часто заблокирован политикой выполнения, и
  // задача падала бы ещё до старта.
  //
  // Задачи с префиксом «Отладка:» — служебные, их запускает launch.json перед
  // подключением отладчика. Руками их выбирать незачем.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Разработка: всё",
      "detail": "Программа и все редакторы разом",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/source_dev" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "Разработка: LARD",
      "detail": "Сервер и окно программы",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "dev:lard"],
      "options": { "cwd": "${workspaceFolder}/source_dev" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "Разработка: редактор тем",
      "detail": "Сервер и окно редактора тем",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "dev:theme"],
      "options": { "cwd": "${workspaceFolder}/source_dev" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "Разработка: только серверы",
      "detail": "Фоновый хост без окон: приложение на 3000, редактор тем на 3100",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "dev:core"],
      "options": { "cwd": "${workspaceFolder}/source_dev" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "Сборка: всё [Windows]",
      "detail": "LARD.exe и все редакторы в app_r",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}/source_dev" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "panel": "dedicated", "group": "build" }
    },
    {
      "label": "Сборка: LARD [Windows]",
      "detail": "Только LARD.exe",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "build:lard"],
      "options": { "cwd": "${workspaceFolder}/source_dev" },
      "problemMatcher": [],
      "group": "build",
      "presentation": { "panel": "dedicated", "group": "build" }
    },
    {
      "label": "Сборка: редактор тем [Windows]",
      "detail": "Только [LARD] Theme Editor.exe",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "build:theme"],
      "options": { "cwd": "${workspaceFolder}/source_dev" },
      "problemMatcher": [],
      "group": "build",
      "presentation": { "panel": "dedicated", "group": "build" }
    },
    {
      "label": "Тесты",
      "detail": "Все пакеты разом",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}/source_dev" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "panel": "dedicated", "group": "check" }
    },
    {
      "label": "Проверка стиля",
      "detail": "Biome: разметка и правила",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "check"],
      "options": { "cwd": "${workspaceFolder}/source_dev" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "check" }
    },

    // --- Служебное для отладки ---------------------------------------------

    {
      // Окно программы грузит страницу с этого сервера. Задача фоновая и
      // никогда не завершается, поэтому отладчику нужен признак «сервер
      // поднялся» — им служит строка Vite про готовность.
      "label": "Отладка: сервер LARD",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "dev", "-w", "app"],
      "options": { "cwd": "${workspaceFolder}/source_dev" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "debug" },
      "problemMatcher": {
        "owner": "vite",
        "fileLocation": ["relative", "${workspaceFolder}/source_dev/app"],
        "pattern": {
          "regexp": "^\\s*(.+?)\\((\\d+),(\\d+)\\):\\s+(error|warning)\\s+(TS\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          // Задача считается запущенной с самого начала и закрывается первой
          // же строкой Vite про готовность. Начальный шаблон нарочно не ловит
          // баннер запуска: в нём «VITE v7.3.1 ready in 311 ms» — и начало, и
          // конец в одной строке, а VS Code на такой строке видит только
          // начало и ждёт конца вечно. Поэтому начало — это перезапуск сервера.
          "activeOnStart": true,
          "beginsPattern": "restarting server",
          "endsPattern": "(ready in|server restarted)"
        }
      }
    },
    {
      "label": "Отладка: сервер редактора тем",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "dev", "-w", "@lard/theme-editor"],
      "options": { "cwd": "${workspaceFolder}/source_dev" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "debug" },
      "problemMatcher": {
        "owner": "vite",
        "fileLocation": [
          "relative",
          "${workspaceFolder}/source_dev/app/src_Tools/src_Theme"
        ],
        "pattern": {
          "regexp": "^\\s*(.+?)\\((\\d+),(\\d+)\\):\\s+(error|warning)\\s+(TS\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          // Задача считается запущенной с самого начала и закрывается первой
          // же строкой Vite про готовность. Начальный шаблон нарочно не ловит
          // баннер запуска: в нём «VITE v7.3.1 ready in 311 ms» — и начало, и
          // конец в одной строке, а VS Code на такой строке видит только
          // начало и ждёт конца вечно. Поэтому начало — это перезапуск сервера.
          "activeOnStart": true,
          "beginsPattern": "restarting server",
          "endsPattern": "(ready in|server restarted)"
        }
      }
    },
    {
      // Главный процесс запускается из dist, а не из TypeScript: перед
      // отладкой его надо собрать.
      "label": "Отладка: сборка главного процесса",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "build", "--prefix", "core/electron"],
      "options": { "cwd": "${workspaceFolder}/source_dev" },
      "problemMatcher": ["$tsc"],
      "presentation": { "panel": "dedicated", "group": "debug", "close": true }
    },
    {
      "label": "Отладка: подготовить LARD",
      "dependsOn": ["Отладка: сервер LARD", "Отладка: сборка главного процесса"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
