{
  "name": "@lard/theme-editor",
  "version": "0.1.0",
  "private": true,
  "description": "[LARD] Theme Editor: редактор тем LARD",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "window": "node ../../../core/tools_shell/launch.cjs http://127.0.0.1:3100/ \"[LARD] Theme Editor\"",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "format": "biome format src --write",
    "check": "biome check src"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lard/core": "*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
