{
  "compilerOptions": {
    "types": [
      "react",
      "react-dom",
      "node",
      "webmidi",
      "wicg-file-system-access",
      "web-bluetooth",
      "vite-plugin-svgr/client",
      // LARD: типы import.meta.glob — на нём держится автоматическая
      // регистрация языков из папки src/localize/Language.
      "vite/client",
      // LARD: глобальные describe/it/expect — тесты запускаются с globals: true.
      "vitest/globals"
    ],
    "sourceMap": true,
    "target": "esnext",
    // LARD: было es2015, при котором import.meta запрещён компилятором.
    // На вывод не влияет — сборку делает Vite, tsc здесь только проверяет типы.
    "module": "esnext",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "lib": ["es2019", "dom", "ESNext.Collection"],
    "strictNullChecks": true,
    "alwaysStrict": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      // Avoid referencing the node_modules of the library when developing a local library.
      "@types/react": ["../node_modules/@types/react"]
    }
  },
  // LARD: пресеты лежат в source_dev/Tools_presets и правятся как обычные
  // файлы. Их нужно явно включить в проверку типов.
  "include": [
    "src/**/*",
    "../Tools_presets/Language/**/*",
    "../Tools_presets/Theme/**/*"
  ]
}
