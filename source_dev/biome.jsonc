{
  "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
  // LARD: .gitignore остался в корне репозитория, на уровень выше этого файла.
  // Biome ищет его рядом с собой и без этого падает, а указать другую папку
  // нельзя: с "root" он перестаёт находить сам конфиг. Поэтому что не нужно
  // проверять, перечислено ниже явно.
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      // LARD: конфиги Vite и служебные скрипты — тоже код проекта.
      // Без этих масок Biome молча пропускал vite.config.mts, dev.mjs,
      // launch.cjs и остальную обвязку.
      "**/*.mts",
      "**/*.cts",
      "**/*.mjs",
      "**/*.cjs",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/dist_renderer/**",
      "!**/build/**",
      "!**/out/**",
      "!**/.turbo/**",
      // Собранная веб-часть инструмента, разложенная в оболочку окна.
      "!**/tools_shell/renderer/**"
    ]
  },
  "overrides": [
    {
      "includes": ["core/electron/scripts/generate-appx-manifest/**"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn",
        "useIterableCallbackReturn": "off",
        "noAssignInExpressions": "warn",
        "noDoubleEquals": "warn",
        "noImplicitAnyLet": "warn",
        "noFallthroughSwitchClause": "warn",
        "noEmptyInterface": "warn",
        "noShadowRestrictedNames": "warn"
      },
      "style": {
        "noUnusedTemplateLiteral": "off",
        "useImportType": "off",
        "useNodejsImportProtocol": "off",
        "useTemplate": "off",
        "noNonNullAssertion": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "warn"
      },
      "a11y": {
        "useKeyWithClickEvents": "off",
        "useAltText": "off",
        "noStaticElementInteractions": "off"
      },
      "complexity": {
        "noUselessFragments": "off",
        "noThisInStatic": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  }
}
