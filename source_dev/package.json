{
  "name": "lard",
  "version": "0.1.0",
  "description": "LARD: MIDI-редактор рядом с Ableton Live. Форк signal.",
  "private": true,
  "scripts": {
    "dev": "node core/scripts/dev.mjs all",
    "dev:lard": "node core/scripts/dev.mjs lard",
    "dev:theme": "node core/scripts/dev.mjs theme",
    "dev:core": "node core/scripts/dev.mjs core",
    "build": "node core/scripts/build-windows.mjs all",
    "build:lard": "node core/scripts/build-windows.mjs lard",
    "build:theme": "node core/scripts/build-windows.mjs theme",
    "test": "turbo test",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryohey/signal.git"
  },
  "author": "ryohey",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ryohey/signal/issues"
  },
  "homepage": "https://github.com/ryohey/signal/",
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "concurrently": "^9.2.1",
    "turbo": "^2.8.10"
  },
  "workspaces": [
    "core",
    "core/packages/*",
    "core/tools_shell",
    "app",
    "app/src_Tools/*"
  ],
  "packageManager": "npm@11.10.1"
}
